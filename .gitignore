__pycache__/

# The database is rebuilt from exports/ by load.py, and both are far too large
# for git: 182 MB and 1.1 GB. The exports are the real source of truth and are
# kept on disk, not in the repo.
spotify.db
exports/

# Build artefacts. Regenerated by ./refresh.
#
# app.html and story.html are NOT artefacts -- they are the templates, and
# story.html currently carries its own hand-written copy. Ignoring all of
# web/*.html cost me the file once already: a bad edit truncated it and there
# was nothing to check out.
web/listening-*.html
web/*.json
web/listening.db
site/

# Spotify API credentials cache for review.py --scan
.explicit-cache.json

# The preview function has no dependencies. node_modules was tracked when the
# question box needed the SDK; it is gone and should not come back.
api/node_modules/

# Spotify API credentials, copied from ~/Documents/spotify-tools/.env
.env.spotify
.dbip/
fetched.json

# Lookups kept between runs. Rebuilt when missing.
art_cache.json
preview_cache.json
.vintage-cache.json
